<%- include('partials/header') %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><% if (activeCategory) { %><a href="/shop">Shop</a><% } else { %><span aria-current="page">Shop</span><% } %></li>
    <% if (activeCategory) { %><li><span aria-current="page"><%= activeCategory.name %></span></li><% } %>
  </ol>
</nav>

<h1><%= sale ? 'Sale' : activeCategory ? activeCategory.name : 'Shop all vapes' %></h1>
<p class="muted" id="result-count"><%= total %> product<%= total === 1 ? '' : 's' %> found<%= q ? ` for "${q}"` : '' %></p>

<form class="filters" method="get" action="/shop" role="search" aria-label="Filter products" id="filter-form">
  <div class="field">
    <label for="q">Search</label>
    <input id="q" name="q" type="search" value="<%= q %>" placeholder="e.g. Elf Bar, Kulfi, Voopoo" maxlength="60" autocomplete="off">
  </div>
  <div class="field">
    <label for="category">Category</label>
    <select id="category" name="category">
      <option value="">All categories</option>
      <% categories.forEach(function (c) { %><option value="<%= c.slug %>" <%= c.slug === category ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="sort">Sort by</label>
    <select id="sort" name="sort">
      <option value="featured" <%= sort === 'featured' ? 'selected' : '' %>>Featured</option>
      <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option>
      <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option>
      <option value="rating" <%= sort === 'rating' ? 'selected' : '' %>>Top rated</option>
      <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name A-Z</option>
    </select>
  </div>
  <label class="choice"><input type="checkbox" name="sale" value="1" <%= sale ? 'checked' : '' %>> Sale items only</label>
  <button class="btn btn--primary" type="submit">Apply</button>
</form>

<% if (products.length) { %>
<h2 class="sr-only">Products</h2>
<div class="grid" id="product-grid">
  <% products.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }) %>
</div>
<p class="empty-live" id="no-live-match" hidden>No products on this page match your search. Press Apply to search the full catalogue.</p>

<% if (pages > 1) { %>
<nav class="pagination" aria-label="Pagination">
  <% for (let i = 1; i <= pages; i++) { %>
    <a href="/shop?<%= new URLSearchParams({ q, category, sort, page: i, ...(sale ? { sale: '1' } : {}) }).toString() %>" <%- i === page ? 'aria-current="page"' : '' %>><span class="sr-only">Page </span><%= i %></a>
  <% } %>
</nav>
<% } %>
<% } else { %>
<div class="empty">
  <h2>No products found</h2>
  <p>Try a different search term or <a href="/shop">browse everything</a>.</p>
</div>
<% } %>

<%- include('partials/footer') %>
