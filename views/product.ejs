<%- include('partials/header') %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/shop">Shop</a></li>
    <li><a href="/shop?category=<%= product.category_slug %>"><%= product.category_name %></a></li>
    <li><span aria-current="page"><%= product.name %></span></li>
  </ol>
</nav>

<article class="product-detail">
  <div class="product-detail__art"><%- include('partials/art', { p: product }) %></div>
  <div class="product-detail__info">
    <p class="product-card__brand"><%= product.brand %></p>
    <h1><%= product.name %></h1>
    <p class="rating">
      <% if (product.review_count) { %>
        <span aria-hidden="true"><%= stars(product.avg_rating) %></span>
        <a href="#reviews"><%= product.avg_rating %> out of 5 (<%= product.review_count %> review<%= product.review_count === 1 ? '' : 's' %>)</a>
      <% } else { %><a href="#reviews">Be the first to review</a><% } %>
    </p>
    <% const onSale = product.old_price_pkr && product.old_price_pkr > product.price_pkr; %>
    <p class="price price--lg <%= onSale ? 'price--sale' : '' %>"><%= pkr(product.price_pkr) %><% if (onSale) { %> <span class="old-price"><span class="sr-only">was </span><%= pkr(product.old_price_pkr) %></span> <span class="badge badge--sale">Save <%= pkr(product.old_price_pkr - product.price_pkr) %></span><% } %></p>
    <p><%= product.description %></p>

    <dl class="specs">
      <div><dt>Category</dt><dd><%= product.category_name %></dd></div>
      <% if (product.nicotine_mg !== null) { %><div><dt>Nicotine</dt><dd><%= product.nicotine_mg === 0 ? 'Nicotine free' : product.nicotine_mg + ' mg/ml' %></dd></div><% } %>
      <% if (product.volume_ml) { %><div><dt>Volume</dt><dd><%= product.volume_ml %> ml</dd></div><% } %>
      <div><dt>Availability</dt><dd><%= product.stock > 5 ? 'In stock' : product.stock > 0 ? 'Only ' + product.stock + ' left' : 'Sold out' %></dd></div>
      <div><dt>Delivery</dt><dd>Rs <%= config.SHIPPING_METRO %> (Karachi, Lahore, Islamabad, Rawalpindi) / Rs <%= config.SHIPPING_OTHER %> elsewhere</dd></div>
    </dl>

    <% if (product.stock > 0) { %>
    <form method="post" action="/cart/add" class="buy-box js-add-to-cart">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <div class="field field--inline">
        <label for="qty">Quantity</label>
        <input id="qty" name="qty" type="number" min="1" max="<%= Math.min(10, product.stock) %>" value="1" inputmode="numeric">
      </div>
      <button class="btn btn--primary btn--lg" type="submit">Add to cart</button>
    </form>
    <% } else { %>
    <p class="flash flash--info">This item is currently sold out. Contact us on WhatsApp +92 300 111 2223 to be notified when it returns.</p>
    <% } %>
    <p class="small muted">Nicotine is addictive. Adults 18+ only. Every order is checked for age on delivery; please keep your CNIC handy.</p>
  </div>
</article>

<section class="section" id="reviews" aria-labelledby="reviews-title">
  <h2 id="reviews-title">Customer reviews</h2>
  <% if (reviews.length) { %>
  <ul class="review-list">
    <% reviews.forEach(function (r) { %>
    <li class="card review">
      <p class="rating" role="img" aria-label="<%= r.rating %> out of 5 stars"><span aria-hidden="true"><%= stars(r.rating) %></span></p>
      <p><%= r.comment %></p>
      <p class="small muted"><strong><%= r.user_name %></strong>, <%= r.city || 'Pakistan' %> &middot; <%= fmtDate(r.created_at) %></p>
    </li>
    <% }) %>
  </ul>
  <% } else { %><p class="muted">No reviews yet.</p><% } %>

  <% if (user) { %>
  <form method="post" action="/product/<%= product.slug %>/review" class="card form-card" novalidate>
    <h3><%= myReview ? 'Update your review' : 'Write a review' %></h3>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="rating">Rating</label>
      <select id="rating" name="rating" required>
        <% [5, 4, 3, 2, 1].forEach(function (n) { %><option value="<%= n %>" <%= myReview && myReview.rating === n ? 'selected' : '' %>><%= n %> - <%= ['', 'Poor', 'Fair', 'Good', 'Very good', 'Excellent'][n] %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="comment">Your comment</label>
      <textarea id="comment" name="comment" rows="3" minlength="5" maxlength="600" required><%= myReview ? myReview.comment : '' %></textarea>
    </div>
    <button class="btn btn--primary" type="submit"><%= myReview ? 'Update review' : 'Post review' %></button>
  </form>
  <% if (myReview) { %>
  <form method="post" action="/product/<%= product.slug %>/review/delete" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="link-button link-button--danger" type="submit">Delete my review</button>
  </form>
  <% } %>
  <% } else { %>
  <p><a href="/login?next=/product/<%= product.slug %>">Sign in</a> to write a review.</p>
  <% } %>
</section>

<% if (related.length) { %>
<section class="section" aria-labelledby="rel-title">
  <h2 id="rel-title" class="section-title">You may also like</h2>
  <div class="grid">
    <% related.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }) %>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
