<%# Product picture: the admin's uploaded photo if there is one, otherwise a simple illustration in the product's colour. Expects `p`. %>
<% if (p.image) { %>
<img class="art art--photo" src="/uploads/<%= p.image %>" alt="<%= typeof decorative !== 'undefined' && decorative ? '' : p.name %>" loading="lazy" decoding="async">
<% } else { %>
<svg class="art" viewBox="0 0 200 200" <%- typeof decorative !== 'undefined' && decorative ? 'aria-hidden="true"' : 'role="img" aria-label="' + p.name.replace(/"/g, '&quot;') + '"' %> focusable="false">
  <% const c = p.color; const slug = p.category_slug; %>
  <% if (slug === 'disposables') { %>
    <rect x="86" y="18" width="28" height="30" rx="8" fill="#1f2937"/>
    <rect x="64" y="40" width="72" height="142" rx="22" fill="<%= c %>"/>
    <rect x="64" y="40" width="72" height="142" rx="22" fill="#fff" fill-opacity=".08"/>
    <rect x="74" y="56" width="14" height="110" rx="7" fill="#fff" fill-opacity=".28"/>
    <rect x="96" y="120" width="30" height="8" rx="4" fill="#000" fill-opacity=".25"/>
    <circle cx="111" cy="150" r="6" fill="#fff" fill-opacity=".55"/>
  <% } else if (slug === 'pod-systems') { %>
    <rect x="80" y="14" width="40" height="34" rx="10" fill="#e5e7eb" fill-opacity=".85"/>
    <rect x="86" y="22" width="28" height="20" rx="5" fill="<%= c %>" fill-opacity=".55"/>
    <rect x="68" y="44" width="64" height="140" rx="20" fill="<%= c %>"/>
    <rect x="68" y="44" width="64" height="140" rx="20" fill="#000" fill-opacity=".1"/>
    <rect x="78" y="58" width="10" height="100" rx="5" fill="#fff" fill-opacity=".3"/>
    <rect x="94" y="136" width="26" height="20" rx="6" fill="#000" fill-opacity=".3"/>
    <circle cx="107" cy="146" r="5" fill="#fff" fill-opacity=".7"/>
  <% } else if (slug === 'box-mods') { %>
    <rect x="84" y="20" width="32" height="46" rx="8" fill="#9ca3af"/>
    <rect x="74" y="12" width="52" height="14" rx="6" fill="#4b5563"/>
    <rect x="52" y="60" width="96" height="128" rx="16" fill="<%= c %>"/>
    <rect x="52" y="60" width="96" height="128" rx="16" fill="#fff" fill-opacity=".07"/>
    <rect x="66" y="76" width="68" height="36" rx="6" fill="#0f172a"/>
    <rect x="72" y="84" width="36" height="6" rx="3" fill="#2dd4bf"/>
    <rect x="72" y="96" width="22" height="6" rx="3" fill="#a78bfa"/>
    <circle cx="100" cy="148" r="16" fill="#0f172a" fill-opacity=".55"/>
    <circle cx="100" cy="148" r="9" fill="#fff" fill-opacity=".7"/>
  <% } else if (slug === 'e-liquids') { %>
    <rect x="84" y="20" width="32" height="22" rx="6" fill="#111827"/>
    <path d="M90 42h20v24H90z" fill="#d1d5db"/>
    <rect x="62" y="64" width="76" height="120" rx="16" fill="<%= c %>" fill-opacity=".92"/>
    <rect x="62" y="64" width="76" height="120" rx="16" fill="#fff" fill-opacity=".1"/>
    <rect x="72" y="100" width="56" height="58" rx="6" fill="#fff" fill-opacity=".85"/>
    <rect x="80" y="110" width="40" height="6" rx="3" fill="<%= c %>"/>
    <rect x="80" y="124" width="28" height="5" rx="2.5" fill="#111827" fill-opacity=".5"/>
    <rect x="80" y="136" width="34" height="5" rx="2.5" fill="#111827" fill-opacity=".3"/>
  <% } else if (slug === 'coils-pods') { %>
    <rect x="70" y="32" width="60" height="30" rx="8" fill="#9ca3af"/>
    <rect x="62" y="58" width="76" height="116" rx="14" fill="<%= c %>"/>
    <rect x="62" y="58" width="76" height="116" rx="14" fill="#000" fill-opacity=".12"/>
    <% for (let i = 0; i < 6; i++) { %><path d="M76 <%= 78 + i * 16 %>h48" stroke="#fff" stroke-opacity=".55" stroke-width="5" stroke-linecap="round"/><% } %>
  <% } else { %>
    <rect x="88" y="14" width="24" height="14" rx="4" fill="#9ca3af"/>
    <rect x="68" y="26" width="64" height="160" rx="14" fill="<%= c %>"/>
    <rect x="68" y="26" width="64" height="160" rx="14" fill="#fff" fill-opacity=".1"/>
    <rect x="68" y="26" width="64" height="30" rx="14" fill="#000" fill-opacity=".25"/>
    <path d="M104 92l-14 24h12l-6 26 18-30h-12z" fill="#fff" fill-opacity=".85"/>
  <% } %>
</svg>
<% } %>
